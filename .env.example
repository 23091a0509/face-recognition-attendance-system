# =====================================================================
# Face Recognition Attendance System - Environment Variables Template
# Copy this file to .env and configure for your deployment environment.
# =====================================================================

# 1. Environment & Server
ENV=production
PORT=8000
TIMEZONE=Asia/Kolkata

# 2. Backend Security Configurations
# JWT signing secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# Shared Service API Key for internal edge-to-backend communication
SERVICE_API_KEY=change-this-to-a-secure-shared-service-key

# 3. Database Configurations
# Path to persistent SQLite database file (mount to volume in Docker / cloud)
DATABASE_PATH=database/attendance.db

# 4. CORS & Web Security
# Frontend URL and allowed origins (comma-separated)
FRONTEND_URL=https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# 5. Biometric Face Recognition & Anti-Spoofing Policies
# Cosine similarity acceptance threshold (0.75 recommended for production)
FACE_RECOGNITION_THRESHOLD=0.75

# Ambiguity margin between top-1 and top-2 candidates (prevents identity confusion)
MIN_MATCH_MARGIN=0.08

# Required consecutive frames matching same identity before marking attendance
REQUIRED_CONSISTENT_FRAMES=3

# Institutional attendance cutoff time (HH:MM in 24h format)
ATTENDANCE_LATE_AFTER=09:15

# 6. Edge Kiosk Camera Service (Only needed when running attendance_service locally)
BACKEND_URL=http://127.0.0.1:8000
CAMERA_INDEX=0
PERFORMANCE_MODE=true
